# MiniVec Application Configuration Template
# Reference template for setting operating-system environment variables.
# Note: MiniVec reads OS environment variables directly; it does not auto-load .env files.

APP_NAME=MiniVec
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Persistence & Storage
DATA_DIR=./data
DATABASE_NAME=minivec.db
